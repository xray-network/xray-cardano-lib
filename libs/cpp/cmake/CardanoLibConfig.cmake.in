@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost CONFIG)
find_dependency(Botan CONFIG)
find_dependency(unofficial-sodium CONFIG)
find_dependency(libsecp256k1 CONFIG)
find_dependency(nlohmann_json CONFIG)
find_dependency(blst CONFIG)

set(_CardanoLib_known_components core crypto chain cip plutus lib)
foreach(_component IN LISTS CardanoLib_FIND_COMPONENTS)
  if(NOT _component IN_LIST _CardanoLib_known_components)
    set(CardanoLib_FOUND FALSE)
    set(CardanoLib_NOT_FOUND_MESSAGE "Unknown CardanoLib component: ${_component}")
    return()
  endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/CardanoLibTargets.cmake")

foreach(_component IN LISTS _CardanoLib_known_components)
  if(TARGET "cardano::${_component}")
    set("CardanoLib_${_component}_FOUND" TRUE)
  endif()
endforeach()

check_required_components(CardanoLib)
