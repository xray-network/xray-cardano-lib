@PACKAGE_INIT@

set(_XRAYCardanoLib_known_components core crypto chain cip plutus lib)
if(NOT XRAYCardanoLib_FIND_COMPONENTS)
  set(XRAYCardanoLib_FIND_COMPONENTS lib)
endif()
foreach(_component IN LISTS XRAYCardanoLib_FIND_COMPONENTS)
  if(NOT _component IN_LIST _XRAYCardanoLib_known_components)
    set(XRAYCardanoLib_FOUND FALSE)
    set(XRAYCardanoLib_NOT_FOUND_MESSAGE "Unknown XRAYCardanoLib component: ${_component}")
    return()
  endif()
endforeach()

set(_XRAYCardanoLib_load core)
if("crypto" IN_LIST XRAYCardanoLib_FIND_COMPONENTS OR "chain" IN_LIST XRAYCardanoLib_FIND_COMPONENTS OR "cip" IN_LIST XRAYCardanoLib_FIND_COMPONENTS OR "plutus" IN_LIST XRAYCardanoLib_FIND_COMPONENTS OR "lib" IN_LIST XRAYCardanoLib_FIND_COMPONENTS)
  list(APPEND _XRAYCardanoLib_load crypto)
  include(CMakeFindDependencyMacro)
  find_dependency(Botan CONFIG)
  find_dependency(unofficial-sodium CONFIG)
  find_dependency(libsecp256k1 CONFIG)
  find_dependency(nlohmann_json CONFIG)
  find_dependency(blst CONFIG)
endif()
if("chain" IN_LIST XRAYCardanoLib_FIND_COMPONENTS OR "cip" IN_LIST XRAYCardanoLib_FIND_COMPONENTS OR "plutus" IN_LIST XRAYCardanoLib_FIND_COMPONENTS OR "lib" IN_LIST XRAYCardanoLib_FIND_COMPONENTS)
  list(APPEND _XRAYCardanoLib_load chain)
endif()
if("cip" IN_LIST XRAYCardanoLib_FIND_COMPONENTS OR "lib" IN_LIST XRAYCardanoLib_FIND_COMPONENTS)
  list(APPEND _XRAYCardanoLib_load cip)
endif()
if("plutus" IN_LIST XRAYCardanoLib_FIND_COMPONENTS OR "lib" IN_LIST XRAYCardanoLib_FIND_COMPONENTS)
  list(APPEND _XRAYCardanoLib_load plutus)
endif()
if("lib" IN_LIST XRAYCardanoLib_FIND_COMPONENTS)
  list(APPEND _XRAYCardanoLib_load lib)
endif()
foreach(_component IN LISTS _XRAYCardanoLib_load)
  string(SUBSTRING "${_component}" 0 1 _first)
  string(TOUPPER "${_first}" _first)
  string(SUBSTRING "${_component}" 1 -1 _rest)
  include("${CMAKE_CURRENT_LIST_DIR}/XRAYCardanoLib${_first}${_rest}Targets.cmake")
endforeach()

foreach(_component IN LISTS _XRAYCardanoLib_known_components)
  if(TARGET "cardano::${_component}")
    set("XRAYCardanoLib_${_component}_FOUND" TRUE)
  endif()
endforeach()

check_required_components(XRAYCardanoLib)
