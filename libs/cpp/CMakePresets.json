{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/cardano-vcpkg-toolchain.cmake",
        "CARDANO_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "ci",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CARDANO_WARNINGS_AS_ERRORS": "ON",
        "CARDANO_PROVIDER_TESTS": "ON"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CARDANO_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "hardening",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CARDANO_HARDENING_CASES": "50000",
        "CARDANO_PROVIDER_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    },
    {
      "name": "hardening",
      "configurePreset": "hardening"
    }
  ],
  "testPresets": [
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "hardening",
      "configurePreset": "hardening",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "ci",
      "steps": [
        {
          "type": "configure",
          "name": "ci"
        },
        {
          "type": "build",
          "name": "ci"
        },
        {
          "type": "test",
          "name": "ci"
        }
      ]
    },
    {
      "name": "sanitizers",
      "steps": [
        {
          "type": "configure",
          "name": "sanitizers"
        },
        {
          "type": "build",
          "name": "sanitizers"
        },
        {
          "type": "test",
          "name": "sanitizers"
        }
      ]
    },
    {
      "name": "hardening",
      "steps": [
        {
          "type": "configure",
          "name": "hardening"
        },
        {
          "type": "build",
          "name": "hardening"
        },
        {
          "type": "test",
          "name": "hardening"
        }
      ]
    }
  ]
}
